```plantuml
@startuml Sequence_Candidature
!theme plain

actor "Candidat / Porteur" as Candidat
participant "FrontendThemingService\n(REQ-006)" as FE
participant "ApiGateway\n(REQ-007)" as API
participant "IAMService\n(REQ-026)" as IAM
participant "AutorisationService\n(REQ-004)" as AUTHZ
participant "WorkflowEngine\n(REQ-002/008)" as BPM
participant "RuleEngine\n(REQ-005/008)" as RULES
participant "JournalisationSecurite\n(REQ-026/029)" as LOG
participant "GEDService\n(REQ-016)" as GED
participant "Notification\n(REQ-015)" as NOTIF

Candidat -> FE : ouvrirPortail()
FE -> API : POST /auth/start
API -> IAM : authentifier()
IAM --> API : jetonSSO
API -> LOG : journaliserConnexion() (REQ-026/029)

Candidat -> FE : saisirCandidature()
FE -> API : POST /candidatures
API -> AUTHZ : verifierDroitEcriture() (REQ-004)
AUTHZ --> API : OK

API -> RULES : evaluerEligibilite() (REQ-008)
RULES --> API : eligible=true/false
API -> RULES : evaluerRecevabilite() (REQ-008)
RULES --> API : recevable=true/false

API -> BPM : demarrerInstance() (REQ-002/008)
BPM --> API : idInstance

API -> GED : classerDocument() (REQ-016)  ' pièces jointes
GED --> API : OK

API -> LOG : journaliserAction() (REQ-029)
API -> NOTIF : envoyer() (REQ-015) ' accusé dépôt + alertes
NOTIF --> API : statutEnvoi

API --> FE : réponse dépôt + statuts
@enduml
```

